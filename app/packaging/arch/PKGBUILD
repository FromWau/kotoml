# Maintainer: FromWau <tobias.frommhund@aon.at>
#
# Packages the kotoml command line for Arch, built straight from the checkout this file sits in, so it packages the
# current tree (committed or not). The binary is a self-contained Kotlin/Native executable and needs no Java runtime.
#
# Building it needs, on the build machine rather than as pacman deps, a JDK for Gradle and a populated Gradle cache
# or network access. Override the checkout with `KOTOML_REPO=/path/to/kotoml makepkg`. Do not run another Gradle
# build in the same tree while makepkg runs; they share build/ directories.

_repo="${KOTOML_REPO:-$(cd "$startdir/../../.." && pwd)}"

_kotoml_version() {
    sed -n 's/^kotomlVersion *= *"\(.*\)"/\1/p' "$_repo/gradle/libs.versions.toml"
}

pkgname=kotoml
pkgver=$(_kotoml_version)
pkgrel=1
pkgdesc="Query TOML like jq, keeping every comment and spelling (self-contained native binary)"
arch=('x86_64')
url="https://github.com/FromWau/kotoml"
# kotoml is MIT; its TOML engine is ported from toml-rs, which is MIT or Apache-2.0.
license=('MIT' 'Apache-2.0')
depends=('glibc')
makedepends=('jdk-openjdk')
optdepends=('bash-completion: tab completion for bash')
# Stripping corrupts a Kotlin/Native binary.
options=('!strip')

_bin="$_repo/app/build/bin/linuxX64/releaseExecutable/kotoml.kexe"

build() {
    cd "$_repo"
    ./gradlew --no-daemon :app:linkReleaseExecutableLinuxX64
}

package() {
    install -Dm755 "$_bin" "$pkgdir/usr/bin/kotoml"

    # Generated by the binary just built, from its own command tree, so they cannot drift from it. Both are pure
    # stdout and read no HOME or XDG directory, so they are safe inside a clean build chroot.
    "$_bin" completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/kotoml"
    "$_bin" completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_kotoml"
    "$_bin" completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/kotoml.fish"
    "$_bin" docs man | install -Dm644 /dev/stdin "$pkgdir/usr/share/man/man1/kotoml.1"

    install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$_repo/core/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT-toml-rs"
    install -Dm644 "$_repo/core/LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE-toml-rs"
}
